{
  "schema_version": 1,
  "projects": [
    {
      "name": "hello-lib",
      "enabled": true,
      "path": "examples/cpp-lib",
      "depends_on": [],
      "targets": [
        {
          "enabled": true,
          "soc": "generic",
          "target_os": "linux",
          "arch": "x86_64",
          "toolchain": "gcc-host-container-v1",
          "runner_labels": [
            "ubuntu-latest"
          ],
          "build_command": "bash \"$CI_CMAKE_BUILD_HELPER\" --source-dir . --build-dir build --generator Ninja --build-jobs \"$CI_BUILD_JOBS\" --define CMAKE_BUILD_TYPE=Release --define CMAKE_C_COMPILER_LAUNCHER=ccache --define CMAKE_CXX_COMPILER_LAUNCHER=ccache",
          "test_command": "test -s build/libhello-lib.a && test -f include/hello_lib.h",
          "fast_test_command": "test -s build/libhello-lib.a && test -f include/hello_lib.h",
          "artifact_paths": [
            "build/libhello-lib.a",
            "include/hello_lib.h"
          ],
          "dependency_lock_files": [],
          "cache_paths": [
            ".ci-cache/ccache"
          ],
          "cache_key_files": [
            "CMakeLists.txt",
            "include/hello_lib.h",
            "src/hello_lib.cpp"
          ],
          "build_parallelism": "auto",
          "cache_scope": "toolchain"
        }
      ],
      "ci_smoke": true
    },
