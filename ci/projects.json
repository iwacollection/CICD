    {
      "name": "hello-service",
      "enabled": true,
      "path": "examples/cpp-service",
      "depends_on": [
        "hello-cpp"
      ],
      "targets": [
        {
          "enabled": true,
          "soc": "generic",
          "target_os": "linux",
          "arch": "x86_64",
          "toolchain": "gcc-host-v1",
          "runner_labels": [
            "ubuntu-latest"
          ],
          "build_command": "set -euo pipefail; test -x \"$CI_UPSTREAM_ROOT/hello-cpp/build/hello-ci\"; mkdir -p dist; \"$CI_UPSTREAM_ROOT/hello-cpp/build/hello-ci\" > dist/service.txt; grep -Fx 'enterprise-ci-platform-ok-v2' dist/service.txt",
          "test_command": "test -s dist/service.txt && grep -Fx 'enterprise-ci-platform-ok-v2' dist/service.txt",
          "fast_test_command": "test -s dist/service.txt && grep -Fx 'enterprise-ci-platform-ok-v2' dist/service.txt",
          "artifact_paths": [
            "dist/service.txt"
          ],
          "dependency_lock_files": [],
          "cache_paths": [],
          "cache_key_files": [],
          "cache_scope": "none"
        }
      ]
    },
    {
      "name": "hello-release",
      "enabled": true,
      "path": "examples/cpp-release",
      "depends_on": [
        "hello-service"
      ],
      "targets": [
        {
          "enabled": true,
          "soc": "generic",
          "target_os": "linux",
          "arch": "x86_64",
          "toolchain": "gcc-host-v1",
          "runner_labels": [
            "ubuntu-latest"
          ],
          "build_command": "set -euo pipefail; test -s \"$CI_UPSTREAM_ROOT/hello-service/dist/service.txt\"; mkdir -p dist; cp \"$CI_UPSTREAM_ROOT/hello-service/dist/service.txt\" dist/release.txt; printf 'release-package-verified\\n' >> dist/release.txt",
          "test_command": "grep -Fx 'enterprise-ci-platform-ok-v2' dist/release.txt && grep -Fx 'release-package-verified' dist/release.txt",
          "fast_test_command": "grep -Fx 'enterprise-ci-platform-ok-v2' dist/release.txt && grep -Fx 'release-package-verified' dist/release.txt",
          "artifact_paths": [
            "dist/release.txt"
          ],
          "dependency_lock_files": [],
          "cache_paths": [],
          "cache_key_files": [],
          "cache_scope": "none"
        }
      ]
