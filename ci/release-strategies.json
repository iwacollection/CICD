{
  "schema_version": 1,
  "description": "环境内灰度走同一套 HTTPRoute 权重。多集群灰度按区域顺序走同一套权重，区域内集群同权，后开区域在打开前保持 0%，并且仍然是灰度而不是蓝绿。多集群蓝绿按同一区域顺序做原子槽位切换，区域内集群共用槽位，后开区域打开前不渲染，预览 header 不改变生产权重。集群名单用 PlacementDecision 和 ApplicationSet 钉死。",
  "artifact_contract": 2,
  "namespace": "apps",
  "gateway_name": "platform-gateway",
  "service_port": 80,
  "preview_header": "x-release-preview",
  "preview_header_value": "true",
  "strategies": {
    "canary": {
      "kind": "traffic",
      "method": "routing",
      "routing": {
        "api": "gateway.networking.k8s.io/v1",
        "kind": "HTTPRoute",
        "backends": ["stable", "canary"]
      },
      "required_cluster_labels": {
        "traffic": "gateway"
      },
      "steps": [
        {"name": "1pct", "canary_weight": 1, "analysis": ["smoke", "error_rate", "latency_p95"]},
        {"name": "5pct", "canary_weight": 5, "analysis": ["error_rate", "latency_p95"]},
        {"name": "25pct", "canary_weight": 25, "analysis": ["error_rate", "latency_p95"]},
        {"name": "50pct", "canary_weight": 50, "analysis": ["error_rate", "latency_p95"]},
        {"name": "100pct", "canary_weight": 100, "analysis": ["error_rate"]}
      ],
      "analysis_thresholds": {
        "error_rate_max": 0.01,
        "latency_p95_max_ms": 300,
        "min_requests": 50
      },
      "abort": "shift_all_weight_to_baseline"
    },
    "blue_green": {
      "kind": "traffic",
      "method": "routing",
      "routing": {
        "api": "gateway.networking.k8s.io/v1",
        "kind": "HTTPRoute",
        "switch": "atomic",
        "slots": ["blue", "green"]
      },
      "required_cluster_labels": {
        "traffic": "gateway"
      },
      "steps": [
        {"name": "deploy_inactive", "traffic": "hold", "analysis": ["readiness"]},
        {"name": "preview", "traffic": "preview", "analysis": ["smoke"]},
        {"name": "cutover", "traffic": "switch", "analysis": ["error_rate", "latency_p95"]},
        {"name": "confirm", "traffic": "active", "analysis": []}
      ],
      "analysis_thresholds": {
        "error_rate_max": 0.01,
        "latency_p95_max_ms": 300,
        "min_requests": 50
      },
      "abort": "restore_baseline_slot"
    },
    "multi_cluster_canary": {
      "kind": "placement",
      "method": "cluster_management",
      "traffic_strategy": "canary",
      "region_order": ["cn-east", "cn-north"],
      "cluster_management": {
        "placement_api": "cluster.open-cluster-management.io/v1beta1",
        "placement_kind": "Placement",
        "decision_kind": "PlacementDecision",
        "delivery_api": "argoproj.io/v1alpha1",
        "delivery_kind": "ApplicationSet"
      },
      "deny_unmatched": true,
      "pin_exact_cluster_ids": true,
      "required_cluster_labels": {
        "traffic": "gateway"
      },
      "abort": "shift_all_weight_to_baseline",
      "waves": [
        {
          "name": "cn-east",
          "selector": {"environment": "production", "region": "cn-east"},
          "strategy": "canary"
        },
        {
          "name": "cn-north",
          "selector": {"environment": "production", "region": "cn-north"},
          "strategy": "canary"
        }
      ]
    },
    "multi_cluster_blue_green": {
      "kind": "placement",
      "method": "cluster_management",
      "traffic_strategy": "blue_green",
      "region_order": ["cn-east", "cn-north"],
      "cluster_management": {
        "placement_api": "cluster.open-cluster-management.io/v1beta1",
        "placement_kind": "Placement",
        "decision_kind": "PlacementDecision",
        "delivery_api": "argoproj.io/v1alpha1",
        "delivery_kind": "ApplicationSet"
      },
      "deny_unmatched": true,
      "pin_exact_cluster_ids": true,
      "required_cluster_labels": {
        "traffic": "gateway"
      },
      "abort": "restore_baseline_slot",
      "waves": [
        {
          "name": "cn-east",
          "selector": {"environment": "production", "region": "cn-east"},
          "strategy": "blue_green"
        },
        {
          "name": "cn-north",
          "selector": {"environment": "production", "region": "cn-north"},
          "strategy": "blue_green"
        }
      ]
    }
  }
}
