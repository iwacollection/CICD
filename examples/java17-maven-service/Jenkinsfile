@Library('iwacollection-cicd') _

/*
 * Consumer template for a trusted Jenkins main-branch job.
 *
 * Configure the Global Pipeline Library named "iwacollection-cicd" to load
 * this repository from an immutable, approved 40-character commit SHA.
 * CICD_PLATFORM_REF must point to that same approved platform commit.
 *
 * java17-maven is currently Candidate. The central resolver deliberately
 * rejects this production consumer until a separate, reviewed Promotion PR
 * changes the registry entry to Active. The candidate compatibility test is
 * executed by the Toolchain Supply Chain GitHub Actions workflow.
 */

pipeline {
    agent {
        label 'linux && docker && java-project-builder'
    }

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    parameters {
        string(
            name: 'CICD_PLATFORM_REF',
            defaultValue: '',
            description: 'Approved 40-character CICD platform commit SHA; must match the Global Shared Library version'
        )
    }

    stages {
        stage('Checkout trusted source') {
            steps {
                checkout scm
                sh '''
                    set -euo pipefail
                    test -n "${GIT_COMMIT:-}"
                    test -n "${GIT_URL:-}"
                    echo "Source commit: $GIT_COMMIT"
                    echo "Source repository: $GIT_URL"
                '''
            }
        }

        stage('Build with centrally managed Java toolchain') {
            steps {
                script {
                    javaToolchainBuild(
                        platformRef: params.CICD_PLATFORM_REF?.trim(),
                        projectDir: 'examples/java17-maven-service',
                        toolchainConfig: 'ci/toolchain.json',
                        trustedBranch: 'main',
                        registryCredentialsId: 'ghcr-readonly'
                    )
                }
            }
        }
    }

    post {
        always {
            echo 'Java toolchain pipeline finished; inspect the resolver/build/Artifact Contract stage logs.'
        }
    }
}
